<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.networking.GUI.StartGameController">
   <children>
      <VBox fx:id="clientSelect" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label fx:id="label" text="What client do you want to use?">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="62.0" prefWidth="600.0" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#selectRMI" text="RMI" />
                  <Button mnemonicParsing="false" onAction="#selectTCP" text="TCP" />
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox fx:id="login" alignment="CENTER" layoutX="156.0" prefHeight="400.0" prefWidth="288.0" spacing="20.0" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="156.0" AnchorPane.rightAnchor="156.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Login">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <TextField fx:id="username" promptText="Username" />
            <PasswordField fx:id="password" promptText="Password" />
            <Button mnemonicParsing="false" onAction="#login" text="Login" />
         </children>
      </VBox>
      <VBox fx:id="newGame" alignment="CENTER" layoutX="157.0" prefHeight="400.0" prefWidth="288.0" spacing="20.0" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="157.0" AnchorPane.rightAnchor="155.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="No game found, let's create one!" />
            <TextField fx:id="numPlayers" promptText="Number of players (2 - 5)" />
            <Button mnemonicParsing="false" onAction="#createGame" text="Create" />
         </children></VBox>
      <VBox fx:id="waiting" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" text="Waiting for other players to connect...">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <VBox fx:id="errorToast" alignment="CENTER" layoutX="48.0" layoutY="361.0" prefHeight="25.0" prefWidth="507.0" style="-fx-background-color: #f00; -fx-background-radius: 5;" visible="false" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="48.0" AnchorPane.rightAnchor="45.0">
         <children>
            <Label text="Error message" textFill="WHITE" />
         </children>
      </VBox>
   </children>
</AnchorPane>
