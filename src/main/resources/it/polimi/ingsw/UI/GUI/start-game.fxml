<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-image: url(&quot;/background.png&quot;); -fx-background-size: cover; -fx-background-position: center center;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.UI.GUI.StartGameController">
   <children>
      <StackPane prefHeight="150.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox fx:id="clientSelect" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="300.0" prefWidth="300.0" styleClass="dark-panel" stylesheets="@style.css">
               <children>
                  <Label fx:id="label" text="Choose your client" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Label>
                  <HBox alignment="CENTER" prefHeight="62.0" prefWidth="600.0" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#selectRMI" styleClass="big-button" text="RMI" />
                        <Button mnemonicParsing="false" onAction="#selectTCP" styleClass="big-button" text="TCP" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox fx:id="login" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="300.0" prefWidth="300.0" spacing="20.0" styleClass="dark-panel" visible="false">
               <children>
                  <Label text="Login" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <TextField fx:id="username" promptText="Username" />
                  <PasswordField fx:id="password" promptText="Password" />
                  <Button mnemonicParsing="false" onAction="#login" styleClass="big-button" text="Login" />
               </children>
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
            </VBox>
            <VBox fx:id="waiting" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="300.0" prefWidth="300.0" spacing="10.0" styleClass="dark-panel" visible="false">
               <children>
                  <Label alignment="CENTER" text=" Waiting for other players... " textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets top="20.0" />
               </padding>
            </VBox>
            <VBox fx:id="newGame" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="300.0" prefWidth="300.0" spacing="20.0" styleClass="dark-panel" visible="false">
               <children>
                  <Label text="Let's create a game!" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font></Label>
                  <TextField fx:id="numPlayers" promptText="Number of players (2 - 5)" />
                  <Button mnemonicParsing="false" onAction="#createGame" styleClass="big-button" text="Create" />
               </children>
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
            </VBox>
            <VBox fx:id="playAgain" alignment="CENTER" layoutX="160.0" layoutY="60.0" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="300.0" prefWidth="300.0" styleClass="dark-panel" stylesheets="@style.css" visible="false">
               <children>
                  <Label fx:id="label1" text="Want to play again?" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Label>
                  <HBox alignment="CENTER" prefHeight="62.0" prefWidth="600.0" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#playAgain" styleClass="big-button" text="Play again" />
                        <Button mnemonicParsing="false" onAction="#quit" styleClass="big-button" text="Quit" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
      <VBox fx:id="errorToast" alignment="CENTER" prefHeight="25.0" prefWidth="507.0" style="-fx-background-color: #F04D3B; -fx-background-radius: 5;" visible="false" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">
         <children>
            <Label text="Error message" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
