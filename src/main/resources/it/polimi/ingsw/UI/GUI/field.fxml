           <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <!--Pane fx:id="cardsContainer" pickOnBounds="false" prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" /-->
               <Label fx:id="debugLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="35.0" prefWidth="499.0" text="Label" textFill="WHITE">
                   <font>
                       <Font name="System Italic" size="16.0" />
                   </font>
                   <padding>
                       <Insets bottom="5.0" top="5.0" />
                   </padding>
               </Label>
               <VBox fx:id="invisibleLayout" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                   <children>
                       <HBox fx:id="topRow" alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                           <children>
                           </children>
                       </HBox>
                       <HBox fx:id="offerPath" alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                           <children>
                           </children>
                       </HBox>
                       <HBox fx:id="bottomRow" alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                           <children>
                           </children>
                       </HBox>
                   </children>
                   <VBox.margin>
                       <Insets bottom="20.0" />
                   </VBox.margin>
               </VBox>
               <HBox fx:id="hand" alignment="CENTER" prefHeight="300.0" prefWidth="200.0" spacing="5" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
               </HBox>
               <padding>
                   <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
           </VBox>
       </HBox>

       <SubScene fx:id="subScene" depthBuffer="true" depthTest="ENABLE" height="400.0" width="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
           <root>
               <Region />
           </root>
       </SubScene>

       <TilePane fx:id="players" alignment="CENTER" orientation="VERTICAL" pickOnBounds="false" prefColumns="1" tileAlignment="CENTER" vgap="20" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
           <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
           </padding>
       </TilePane>

       <VBox fx:id="errorToast" alignment="CENTER" layoutX="48.0" layoutY="361.0" prefHeight="25.0" prefWidth="507.0" style="-fx-background-color: #F04D3B; -fx-background-radius: 5;" visible="false" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="48.0" AnchorPane.rightAnchor="45.0">
           <children>
               <Label text="Error message" textFill="WHITE" />
           </children>
       </VBox>

       <StackPane pickOnBounds="false" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
           <VBox fx:id="totemSelect" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="300.0" prefWidth="400.0" spacing="20.0" styleClass="dark-panel" stylesheets="@style.css">
