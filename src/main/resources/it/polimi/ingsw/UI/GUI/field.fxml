                   <Label text="Choose your totem" textFill="WHITE">
                       <font>
                           <Font name="System Bold" size="20.0" />
                       </font>
                       <opaqueInsets>
                           <Insets />
                       </opaqueInsets>
                   </Label>
                   <HBox fx:id="totemList" alignment="CENTER" prefHeight="62.0" prefWidth="600.0" spacing="10.0">
                       <children>
                       </children>
                   </HBox>
               </children>
               <padding>
                   <Insets left="10.0" right="10.0" />
               </padding>
           </VBox>

           <VBox fx:id="ranking" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="400.0" style="-fx-background-color: #171717; -fx-background-radius: 10;" visible="false">
               <children>
                   <Label text="Ranking" textFill="WHITE">
                       <font>
                           <Font name="System Bold" size="30.0" />
                       </font>
                       <padding>
                           <Insets bottom="20.0" />
                       </padding>
                   </Label>

                   <GridPane fx:id="rankingGrid" hgap="10" vgap="10" xmlns:fx="http://javafx.com/fxml/1">
                       <columnConstraints>
                           <ColumnConstraints halignment="RIGHT" hgrow="ALWAYS" />
                           <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" />
                       </columnConstraints>

                       <children>
                       </children>
                  <rowConstraints>
                     <RowConstraints />
                  </rowConstraints>

                   </GridPane>
               </children>

               <padding>
                   <Insets top="20.0" />
               </padding>
           </VBox>
       </StackPane>

       <Text fx:id="round" style="-fx-font-size: 60; -fx-fill: #fff; -fx-stroke: #000; -fx-stroke-width: 2" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">Round 1</Text>
